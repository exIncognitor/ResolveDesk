# Configure your own key locally in .env; keep it out of chat and source control.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_MODEL=deepseek-flash
RESOLVEDESK_OWN_KEY_CONFIRMED=false
RESOLVEDESK_PAID_API_ENABLED=false
RESOLVEDESK_TOTAL_BUDGET_CNY=20
RESOLVEDESK_RESERVE_CNY=2
RESOLVEDESK_INPUT_CNY_PER_MILLION=2
RESOLVEDESK_OUTPUT_CNY_PER_MILLION=8
RESOLVEDESK_MAX_OUTPUT_TOKENS=2048
RESOLVEDESK_MAX_INPUT_BYTES=65536
RESOLVEDESK_LEDGER_PATH=data/billing/usage.sqlite3
# Service mode requires PostgreSQL, Redis, Chroma and the pinned local model.
# tools/setup_services.py creates ignored local passwords; explicit overrides:
# RESOLVEDESK_DATABASE_URL=postgresql+psycopg://user:password@host:5432/resolvedesk
# RESOLVEDESK_REDIS_URL=redis://:password@host:6379/0
# RESOLVEDESK_CHROMA_URL=http://127.0.0.1:18001
INTENT_EMBEDDING_PROVIDER=local
# Current IT router: pinned local E5 by default. The line above is for api.main.
RESOLVEDESK_INTENT_VECTOR_PROVIDER=local_e5
# Optional authenticated self-hosted E5 service; no third-party embedding calls.
# RESOLVEDESK_INTENT_VECTOR_PROVIDER=self_hosted_http
# RESOLVEDESK_INTENT_VECTOR_URL=http://127.0.0.1:18002
# RESOLVEDESK_EMBEDDING_TOKEN=<dedicated-random-token-at-least-32-characters>
SILICONFLOW_API_KEY=
MCP_EXTERNAL_ENABLED=false
RESOLVEDESK_ENV=development
RESOLVEDESK_SEED_DEMO_DOCS=true
# Optional outgoing alert destination; empty means retain local outbox only.
RESOLVEDESK_ALERT_WEBHOOK=
# The following unprefixed storage fields serve only api.main compatibility.
# resolvedesk.app uses tools/setup_services.py or explicit prefixed URLs above.
REDIS_URL=redis://localhost:6379
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma
