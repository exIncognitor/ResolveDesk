{
  "servers": [
    {
      "name": "support",
      "transport": "stdio",
      "command": "{python}",
      "args": ["{project_root}/resolvedesk/mcp_support.py"],
      "allowed_tools": ["support_checklist"],
      "agents": ["general", "technical", "billing", "escalation"],
      "read_only": true,
      "timeout_s": 10,
      "cache_ttl": 30
    },
    {
      "name": "documents",
      "enabled": false,
      "transport": "streamable_http",
      "url": "https://mcp.example.com/mcp",
      "headers_env": {"Authorization": "MCP_DOCUMENTS_AUTHORIZATION"},
      "allowed_tools": ["search_documents", "read_document"],
      "agents": ["technical", "general"],
      "read_only": true,
      "timeout_s": 15,
      "cache_ttl": 0,
      "ping_interval_s": 15
    }
  ]
}
